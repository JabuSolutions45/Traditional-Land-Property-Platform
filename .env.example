# Public Supabase placeholders. Add development values locally only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-key

# Never expose the Supabase service-role key through NEXT_PUBLIC_* variables.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not required in Phase 0.
